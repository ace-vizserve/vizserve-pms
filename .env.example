# VizServe PMS — environment variables
# Copy to .env.local (or .env) and fill in. Never commit the filled file.
#
# The Supabase project is a NEW, DEDICATED project — not the HFSE SIS one (D9).

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable ("anon") key. Public by design — it is shipped to the browser and
# is safe there ONLY because RLS is on for every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret ("service role") key. BYPASSES RLS. Server-side only, never prefixed
# NEXT_PUBLIC_. Needed for seeding (P0-12), the public submission path (P1-07)
# and the Phase 4 cron.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- The db test suite (tests/db/*) -----------------------------------------
# ⚠️ ITS OWN PROJECT, AND THAT IS NOT A SUGGESTION. Eighteen files in tests/db
# WRITE — they submit requests, approve them, hand tasks over and delete what
# they made. They used to read NEXT_PUBLIC_SUPABASE_URL above, so from 18 Aug to
# 5 Sep 2026 every `npm run verify` ran them against the live project and left
# 12,378 orphaned approval rows behind. tests/db/helpers.ts now reads only these
# three, and REFUSES to run if they name the same project as the app.
#
# Leave them unset and the suite skips, which is the right default for a fresh
# checkout and for CI. To actually run it: `npm run db:start` (Docker), or a
# scratch Supabase project, then `npm run seed` against it.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SECRET_KEY=

# --- App --------------------------------------------------------------------
# The one canonical origin. Used for the SSO redirect AND for absolute links in
# emails, which is why there is only one variable for it — two names is how the
# auth callback and the email links end up pointing at different hosts. Phase 4
# sends these links to clients, so it must be real and reachable by then (D17).
#
# Port 3000 on the build machine is the HFSE SIS app, whose login page also says
# "Welcome back". Locally: PORT=3177 npm run dev
NEXT_PUBLIC_SITE_URL=http://localhost:3177

# --- Email (P0-11; Resend-only since P8-16) ---------------------------------
# Resend, sending from vizserve.com (D16/Q12). ONE TRANSPORT: EmailJS carried
# this between P8-10 and P8-13 and was removed entirely in P8-16, so there is no
# EMAIL_TRANSPORT switch and no *_EMAILJS_* keys any more.
#
# ⚠️ EMAIL_FROM MUST BE ON A DOMAIN VERIFIED IN THE RESEND DASHBOARD, with its
# DNS records published. An unverified sender is not a warning — Resend refuses
# the send, so every email comes back `failed` while the key, the transport and
# `emailMode()` all look correct. Left unset, the default sender is Resend's
# shared sandbox address, which delivers ONLY to the Resend account owner's own
# address: enough for a first smoke test, useless for Phase 4.
#
# With RESEND_API_KEY unset the mailer runs in DRY-RUN: it renders, logs the
# subject line, and sends nothing. That is a supported way to work — a mailer
# that throws on a missing key turns every server action into a landmine.
#
# In EITHER mode, any address at a reserved domain (example.com and friends —
# i.e. every seeded account) is refused at the sender. Dev and staging never
# deliver real mail, and that rule is enforced rather than remembered.
RESEND_API_KEY=re_xxx
# --- Who it comes FROM (P8-15) ----------------------------------------------
# Four mailboxes on vizserve.com, split by what the email IS rather than who it
# goes to. Verifying the DOMAIN in Resend covers all four - there is no
# per-address setup - but each one still has to be a REAL, MONITORED mailbox.
# Deliberately not `noreply@`, which is what this file used to suggest.
#
# The split earns its keep because a recipient filters, mutes and marks as spam
# PER SENDER. One address means a client tired of surveys can bin the Gate 3
# approval email that Phase 4 rests on.
EMAIL_FROM_APPROVALS="VizServe Approvals <approvals@vizserve.com>"
EMAIL_FROM_NOTIFICATIONS="VizServe Team Portal <notifications@vizserve.com>"
EMAIL_FROM_SUPPORT="VizServe Support <support@vizserve.com>"
EMAIL_FROM_SURVEY="VizServe <survey@vizserve.com>"

# The safety net for a sender whose own var is unset, and enough on its own for
# a dev with one address. Unset too, the fallback is Resend's sandbox sender,
# which delivers ONLY to the Resend account owner - and says so in the log
# rather than failing at the transport.
EMAIL_FROM="VizServe Team Portal <notifications@vizserve.com>"

# Optional, and UNSET IS THE RIGHT ANSWER while EMAIL_FROM is replyable - a
# Reply-To identical to the From is one more header to keep in sync for no
# behaviour. Nothing varies it per message, and `emailReplyTo()` in
# lib/email/config.ts says why that is deliberate rather than unfinished.
EMAIL_REPLY_TO=

# Sends one real message through the real template, to check it lands in an
# inbox rather than a spam folder — the P0-11 exit criterion:
#   EMAIL_TEST_RECIPIENT=you@yourdomain.com npm run email:test
EMAIL_TEST_RECIPIENT=

# --- Cron (P0-11, P4-09) ----------------------------------------------------
# Bearer token for /api/cron/*. If unset, those routes return 404 — closed, not
# open. Vercel sends it automatically as the Authorization header.
CRON_SECRET=
