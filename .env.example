# VizServe PMS — environment variables
# Copy to .env.local (or .env) and fill in. Never commit the filled file.
#
# The Supabase project is a NEW, DEDICATED project — not the HFSE SIS one (D9).

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable ("anon") key. Public by design — it is shipped to the browser and
# is safe there ONLY because RLS is on for every table.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret ("service role") key. BYPASSES RLS. Server-side only, never prefixed
# NEXT_PUBLIC_. Needed for seeding (P0-12), the public submission path (P1-07)
# and the Phase 4 cron.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- App --------------------------------------------------------------------
# The one canonical origin. Used for the SSO redirect AND for absolute links in
# emails, which is why there is only one variable for it — two names is how the
# auth callback and the email links end up pointing at different hosts. Phase 4
# sends these links to clients, so it must be real and reachable by then (D17).
#
# Port 3000 on the build machine is the HFSE SIS app, whose login page also says
# "Welcome back". Locally: PORT=3177 npm run dev
NEXT_PUBLIC_SITE_URL=http://localhost:3177

# --- Email (P0-11) ----------------------------------------------------------
# resend, sending from vizserve.com (D16/Q12).
#
# With RESEND_API_KEY unset the mailer runs in DRY-RUN: it renders, logs the
# subject line, and sends nothing. That is a supported way to work — a mailer
# that throws on a missing key turns every server action into a landmine.
#
# In EITHER mode, any address at a reserved domain (example.com and friends —
# i.e. every seeded account) is refused at the sender. Dev and staging never
# deliver real mail, and that rule is enforced rather than remembered.
RESEND_API_KEY=re_xxx
EMAIL_FROM="VizServe <no-reply@vizserve.com>"
# Optional. Where a client's reply goes; the default is nowhere.
EMAIL_REPLY_TO=

# Sends one real message through the real template, to check it lands in an
# inbox rather than a spam folder — the P0-11 exit criterion:
#   EMAIL_TEST_RECIPIENT=you@yourdomain.com npm run email:test
EMAIL_TEST_RECIPIENT=

# --- Cron (P0-11, P4-09) ----------------------------------------------------
# Bearer token for /api/cron/*. If unset, those routes return 404 — closed, not
# open. Vercel sends it automatically as the Authorization header.
CRON_SECRET=

# --- Transport selection (P8-10) --------------------------------------------
# Which adapter `sendEmail()` uses: "emailjs" or "resend". Unset infers it from
# whichever set of keys is configured. This ONE line is the whole switch — no
# call site names a transport.
EMAIL_TRANSPORT=emailjs

# --- EmailJS (P8-10) --------------------------------------------------------
# The three public values were already here under Vite's prefix; they are not
# credentials. The private key is, so it carries NO prefix and must never be
# handed to a browser.
#
# ⚠️ SETTING THESE IS NOT ENOUGH. EmailJS disables non-browser API requests by
# default — turn them on in the dashboard under Account -> Security, or every
# server-side send is rejected.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=
