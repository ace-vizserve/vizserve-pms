# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# supabase
supabase/.temp
supabase/.branches

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*.xlsx
# Generated previews — regenerate with `node docs/emailjs/preview.mjs`
docs/emailjs/preview-*.html

# The seeded design canvas is a build artefact — ~2 MB of editor baked around
# the .dc.html sources beside it, regenerated by the design skill. The
# artboards and canvas.json are the source; this is the output.
design/*.html
!design/*.dc.html

# P7-67 — the ClickUp import's working files.
#
# `clickup-export.json` is extracted from the gitignored xlsx and carries the
# same thing it does: comment text, staff email addresses, CDN links. It is
# derived, so it is regenerated rather than kept.
#
# `rollback-*.json` is production state — the comment bodies as they were before
# an import ran, and the ids it created. Precious while a run is in flight and
# meaningless against any other database.
clickup-export.json
rollback-*.json
